{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/core.py",
              "ru"
            ],
            "env": {
              "MAST_ALWAYS_CORE": "${user_config.always_core}"
            }
          },
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/dispatcher.py",
              "ru"
            ]
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/dispatcher.py",
              "ru"
            ]
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/roadmap_watch.py",
              "ru"
            ],
            "if": "Bash(git *)"
          },
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/roadmap_watch.py",
              "ru"
            ],
            "if": "PowerShell(git *)"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/roadmap_watch.py",
              "ru"
            ]
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/roadmap_lint.py",
              "ru"
            ],
            "if": "Edit(**/ROADMAP.md)"
          },
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/roadmap_lint.py",
              "ru"
            ],
            "if": "Write(**/ROADMAP.md)"
          },
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/roadmap_lint.py",
              "ru"
            ],
            "if": "Edit(**/docs/roadmap/DONE.md)"
          },
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/roadmap_lint.py",
              "ru"
            ],
            "if": "Write(**/docs/roadmap/DONE.md)"
          }
        ]
      }
    ]
  }
}
