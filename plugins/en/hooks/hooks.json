{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/../../hooks/core.py",
              "en"
            ]
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/../../hooks/roadmap_lint.py",
              "en"
            ],
            "if": "Edit(**/ROADMAP.md)"
          },
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/../../hooks/roadmap_lint.py",
              "en"
            ],
            "if": "Write(**/ROADMAP.md)"
          },
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/../../hooks/roadmap_lint.py",
              "en"
            ],
            "if": "Edit(**/docs/roadmap/DONE.md)"
          },
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/../../hooks/roadmap_lint.py",
              "en"
            ],
            "if": "Write(**/docs/roadmap/DONE.md)"
          }
        ]
      }
    ]
  }
}
