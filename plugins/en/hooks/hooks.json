{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/core.py",
              "en"
            ],
            "env": {
              "MAST_ALWAYS_CORE": "${user_config.always_core}"
            }
          },
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/dispatcher.py",
              "en"
            ]
          }
        ]
      }
    ],
